{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Studio OS Market Approval Queue Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "status", "items", "boundaries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "status": { "enum": ["connected", "failed", "not-configured", "unknown"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approvalId", "opportunityId", "status", "confidence", "evidence", "sourceLineage"],
        "properties": {
          "approvalId": { "type": "string" },
          "opportunityId": { "type": "string" },
          "status": { "enum": ["PENDING_REVIEW", "APPROVED", "REJECTED", "UNKNOWN"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array" },
          "sourceLineage": { "type": "array" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["readOnly", "publishesContent", "executesApprovalActions", "mutatesExternalSystems"],
      "properties": {
        "readOnly": { "const": true },
        "publishesContent": { "const": false },
        "executesApprovalActions": { "const": false },
        "mutatesExternalSystems": { "const": false }
      }
    }
  }
}

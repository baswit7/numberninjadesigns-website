{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Studio OS Market Signals Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "status", "signals", "boundaries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "status": { "enum": ["connected", "failed", "not-configured", "unknown"] },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signalId", "sourceType", "classification", "confidence", "evidence", "sourceLineage"],
        "properties": {
          "signalId": { "type": "string" },
          "sourceType": { "type": "string" },
          "classification": { "enum": ["A", "B", "C", "UNKNOWN"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array" },
          "sourceLineage": { "type": "array" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["readOnly", "usesPublicSignalsOnly", "usesLoginAutomation", "publishesContent", "exposesSecrets"],
      "properties": {
        "readOnly": { "const": true },
        "usesPublicSignalsOnly": { "const": true },
        "usesLoginAutomation": { "const": false },
        "publishesContent": { "const": false },
        "exposesSecrets": { "const": false }
      }
    }
  }
}

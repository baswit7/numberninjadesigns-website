{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Studio OS Market Recommendations Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "status", "recommendations", "boundaries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "status": { "enum": ["connected", "failed", "not-configured", "unknown"] },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendationId", "opportunityId", "approvalStatus", "confidence", "evidence", "sourceLineage", "outputs"],
        "properties": {
          "recommendationId": { "type": "string" },
          "opportunityId": { "type": "string" },
          "approvalStatus": { "const": "APPROVED" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array" },
          "sourceLineage": { "type": "array" },
          "outputs": {
            "type": "object",
            "required": ["productIdea", "audience", "titleAngle", "contentAngle", "tikTokCaption", "hashtags", "etsyTitle", "etsyTags", "pinterestTitle", "pinterestDescription"]
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["readOnly", "publishesContent", "executesPosting", "mutatesExternalSystems"],
      "properties": {
        "readOnly": { "const": true },
        "publishesContent": { "const": false },
        "executesPosting": { "const": false },
        "mutatesExternalSystems": { "const": false }
      }
    }
  }
}

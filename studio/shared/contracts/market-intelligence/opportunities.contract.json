{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Studio OS Market Opportunities Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "status", "opportunities", "boundaries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "status": { "enum": ["connected", "failed", "not-configured", "unknown"] },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["opportunityId", "kind", "classification", "confidence", "evidence", "sourceLineage"],
        "properties": {
          "opportunityId": { "type": "string" },
          "kind": { "enum": ["product", "content", "seo", "platform"] },
          "classification": { "enum": ["A", "B", "C", "UNKNOWN"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array" },
          "sourceLineage": { "type": "array" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["readOnly", "publishesContent", "usesOAuthAutomation", "usesPrivateScraping"],
      "properties": {
        "readOnly": { "const": true },
        "publishesContent": { "const": false },
        "usesOAuthAutomation": { "const": false },
        "usesPrivateScraping": { "const": false }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/simulation-review/simulation-review.schema.json",
  "title": "Phase 23 Simulation Evidence Review Report",
  "description": "Explanation-only review report for Phase 22 simulation outcomes. It attributes evidence and root causes without execution, approval, repair, synchronization or simulation truth ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "reportId",
    "generatedBy",
    "generatedAt",
    "reviewQuestion",
    "sourceOfTruth",
    "consumedReports",
    "status",
    "summary",
    "outcomeReview",
    "rootCauseClassification",
    "evidenceAttribution",
    "reviewConfidence",
    "explainability",
    "unknowns",
    "boundary"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "phase": { "type": "string", "const": "phase-23" },
    "reportId": { "type": "string", "const": "simulation-evidence-review" },
    "generatedBy": { "type": "string", "const": "services/simulation-review/generate-simulation-review.ps1" },
    "generatedAt": { "type": "string", "minLength": 20 },
    "reviewQuestion": { "type": "string", "minLength": 20 },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation", "validation", "evidence", "history", "observability"],
      "properties": {
        "simulation": { "type": "string", "const": "runtime/simulation/execution-simulation.report.json" },
        "validation": { "type": "string", "const": "runtime/simulation/execution-simulation-validation.report.json" },
        "evidence": { "type": "string", "const": "runtime/authority/authority-monitoring-evidence.report.json" },
        "history": { "type": "string", "const": "runtime/authority/authority-evidence-history.report.json" },
        "observability": { "type": "string", "const": "runtime/authority/authority-observability.report.json" }
      }
    },
    "consumedReports": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/reportInput" } },
    "status": { "type": "string", "enum": ["pass", "warning", "unknown"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knownInputCount", "unknownInputCount", "staleInputCount", "warningCount", "unknownCount", "attributedEvidenceCount", "rootCauseCount", "reviewConfidenceScore", "sourceSimulationStatus"],
      "properties": {
        "knownInputCount": { "type": "integer", "minimum": 0 },
        "unknownInputCount": { "type": "integer", "minimum": 0 },
        "staleInputCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "unknownCount": { "type": "integer", "minimum": 0 },
        "attributedEvidenceCount": { "type": "integer", "minimum": 0 },
        "rootCauseCount": { "type": "integer", "minimum": 0 },
        "reviewConfidenceScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "sourceSimulationStatus": { "type": "string", "enum": ["pass", "warning", "unknown"] }
      }
    },
    "outcomeReview": { "$ref": "#/$defs/reviewGroup" },
    "rootCauseClassification": { "$ref": "#/$defs/reviewGroup" },
    "evidenceAttribution": { "$ref": "#/$defs/reviewGroup" },
    "reviewConfidence": { "$ref": "#/$defs/reviewGroup" },
    "explainability": { "$ref": "#/$defs/reviewGroup" },
    "unknowns": { "$ref": "#/$defs/reviewGroup" },
    "boundary": { "$ref": "#/$defs/boundary" }
  },
  "$defs": {
    "reportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "exists", "validJson", "lastModified", "isStale", "isComplete", "verdict", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "role": { "type": "string", "minLength": 3 },
        "exists": { "type": "boolean" },
        "validJson": { "type": "boolean" },
        "lastModified": { "type": ["string", "null"] },
        "isStale": { "type": "boolean" },
        "isComplete": { "type": "boolean" },
        "verdict": { "type": "string", "enum": ["known", "unknown"] },
        "reason": { "type": "string", "minLength": 3 }
      }
    },
    "reviewGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warning", "unknown"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/reviewItem" } }
      }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "source", "safe"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "status": { "type": "string", "enum": ["pass", "warning", "unknown"] },
        "summary": { "type": "string", "minLength": 3 },
        "source": { "type": "string", "minLength": 3 },
        "safe": { "type": "boolean" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewOnly",
        "explanationOnly",
        "readOnly",
        "derivedOnly",
        "reportWritingOnly",
        "ownsReviewReports",
        "ownsAuthorityTruth",
        "ownsGovernanceTruth",
        "ownsEvidenceTruth",
        "ownsMonitoringTruth",
        "ownsHistoryTruth",
        "ownsObservabilityTruth",
        "ownsSimulationTruth",
        "createsDecisions",
        "createsApprovals",
        "executionAllowed",
        "providerInvocationAllowed",
        "deploymentAllowed",
        "workflowExecutionAllowed",
        "commandExecutionAllowed",
        "orchestrationAllowed",
        "automationAllowed",
        "repairAllowed",
        "synchronizationAllowed",
        "approvalWorkflowAllowed",
        "approvalMutationAllowed",
        "authorityMutationAllowed",
        "evidenceMutationAllowed",
        "simulationMutationAllowed",
        "contractMutationAllowed",
        "credentialAccessAllowed",
        "secretAccessAllowed",
        "runtimeMutationAllowed",
        "dashboardMutationAllowed",
        "queueAllowed",
        "workerAllowed",
        "schedulerAllowed",
        "backgroundJobAllowed",
        "selfHealingAllowed",
        "retryAllowed",
        "providerAdapterAllowed",
        "stateChangingRecommendationAllowed"
      ],
      "properties": {
        "reviewOnly": { "type": "boolean", "const": true },
        "explanationOnly": { "type": "boolean", "const": true },
        "readOnly": { "type": "boolean", "const": true },
        "derivedOnly": { "type": "boolean", "const": true },
        "reportWritingOnly": { "type": "boolean", "const": true },
        "ownsReviewReports": { "type": "boolean", "const": true },
        "ownsAuthorityTruth": { "type": "boolean", "const": false },
        "ownsGovernanceTruth": { "type": "boolean", "const": false },
        "ownsEvidenceTruth": { "type": "boolean", "const": false },
        "ownsMonitoringTruth": { "type": "boolean", "const": false },
        "ownsHistoryTruth": { "type": "boolean", "const": false },
        "ownsObservabilityTruth": { "type": "boolean", "const": false },
        "ownsSimulationTruth": { "type": "boolean", "const": false },
        "createsDecisions": { "type": "boolean", "const": false },
        "createsApprovals": { "type": "boolean", "const": false },
        "executionAllowed": { "type": "boolean", "const": false },
        "providerInvocationAllowed": { "type": "boolean", "const": false },
        "deploymentAllowed": { "type": "boolean", "const": false },
        "workflowExecutionAllowed": { "type": "boolean", "const": false },
        "commandExecutionAllowed": { "type": "boolean", "const": false },
        "orchestrationAllowed": { "type": "boolean", "const": false },
        "automationAllowed": { "type": "boolean", "const": false },
        "repairAllowed": { "type": "boolean", "const": false },
        "synchronizationAllowed": { "type": "boolean", "const": false },
        "approvalWorkflowAllowed": { "type": "boolean", "const": false },
        "approvalMutationAllowed": { "type": "boolean", "const": false },
        "authorityMutationAllowed": { "type": "boolean", "const": false },
        "evidenceMutationAllowed": { "type": "boolean", "const": false },
        "simulationMutationAllowed": { "type": "boolean", "const": false },
        "contractMutationAllowed": { "type": "boolean", "const": false },
        "credentialAccessAllowed": { "type": "boolean", "const": false },
        "secretAccessAllowed": { "type": "boolean", "const": false },
        "runtimeMutationAllowed": { "type": "boolean", "const": false },
        "dashboardMutationAllowed": { "type": "boolean", "const": false },
        "queueAllowed": { "type": "boolean", "const": false },
        "workerAllowed": { "type": "boolean", "const": false },
        "schedulerAllowed": { "type": "boolean", "const": false },
        "backgroundJobAllowed": { "type": "boolean", "const": false },
        "selfHealingAllowed": { "type": "boolean", "const": false },
        "retryAllowed": { "type": "boolean", "const": false },
        "providerAdapterAllowed": { "type": "boolean", "const": false },
        "stateChangingRecommendationAllowed": { "type": "boolean", "const": false }
      }
    }
  }
}

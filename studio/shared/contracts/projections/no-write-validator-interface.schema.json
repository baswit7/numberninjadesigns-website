{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/projections/no-write-validator-interface.schema.json",
  "title": "Phase 13 No-Write Validator Interface",
  "description": "Defines structural validation results that inspect projection boundaries without mutating runtime, dashboard, providers, deployments or config.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "validatorId",
    "evaluatedAt",
    "mode",
    "scope",
    "result",
    "checks",
    "boundary",
    "nonExecutableMetadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "validatorId": {
      "$ref": "#/$defs/identifier"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "const": "no-write-structural-inspection"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structureOnly",
        "businessRulesEvaluated",
        "runtimeTruthModified",
        "dashboardModified",
        "configurationModified"
      ],
      "properties": {
        "structureOnly": {
          "type": "boolean",
          "const": true
        },
        "businessRulesEvaluated": {
          "type": "boolean",
          "const": false
        },
        "runtimeTruthModified": {
          "type": "boolean",
          "const": false
        },
        "dashboardModified": {
          "type": "boolean",
          "const": false
        },
        "configurationModified": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "message"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "message": {
            "$ref": "#/$defs/displayText"
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writesAllowed",
        "runtimeMutationAllowed",
        "dashboardMutationAllowed",
        "providerCallsAllowed",
        "deploymentAllowed",
        "credentialAccessAllowed"
      ],
      "properties": {
        "writesAllowed": {
          "type": "boolean",
          "const": false
        },
        "runtimeMutationAllowed": {
          "type": "boolean",
          "const": false
        },
        "dashboardMutationAllowed": {
          "type": "boolean",
          "const": false
        },
        "providerCallsAllowed": {
          "type": "boolean",
          "const": false
        },
        "deploymentAllowed": {
          "type": "boolean",
          "const": false
        },
        "credentialAccessAllowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "nonExecutableMetadata": {
      "$ref": "#/$defs/nonExecutableMetadata"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "pattern": "^[a-z0-9][a-z0-9._:-]*[a-z0-9]$"
    },
    "displayText": {
      "type": "string",
      "minLength": 2,
      "maxLength": 800
    },
    "nonExecutableMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "owner",
        "safetyClass"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "const": "phase-13"
        },
        "owner": {
          "type": "string",
          "const": "studio-os"
        },
        "safetyClass": {
          "type": "string",
          "const": "no-write-validation-interface"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/execution/rollback-plan.schema.json",
  "title": "Phase 9 Rollback Plan",
  "description": "Models rollback readiness for future execution review. It never performs rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rollbackPlanId",
    "requestId",
    "readiness",
    "reversible",
    "preconditions",
    "rollbackSteps",
    "validationChecks",
    "executionAllowed",
    "nonExecutableMetadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "rollbackPlanId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._:-]*[a-z0-9]$"
    },
    "requestId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._:-]*[a-z0-9]$"
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "missing",
        "not-reversible"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "preconditions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      }
    },
    "rollbackSteps": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    },
    "validationChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      }
    },
    "executionAllowed": {
      "type": "boolean",
      "const": false
    },
    "nonExecutableMetadata": {
      "$ref": "#/$defs/nonExecutableMetadata"
    }
  },
  "$defs": {
    "nonExecutableMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "owner",
        "safetyClass"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "const": "phase-9"
        },
        "owner": {
          "type": "string",
          "const": "studio-os"
        },
        "safetyClass": {
          "type": "string",
          "const": "rollback-governance-only"
        }
      }
    }
  }
}

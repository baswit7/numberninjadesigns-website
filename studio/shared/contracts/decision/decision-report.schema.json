{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/decision/decision-report.schema.json",
  "title": "Phase 24 Execution Readiness Decision Report",
  "description": "Read-only derived decision report answering whether execution would theoretically be allowed if execution existed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "reportId",
    "generatedBy",
    "generatedAt",
    "decisionQuestion",
    "decision",
    "sourceOfTruth",
    "consumedReports",
    "summary",
    "reasons",
    "blockingConditions",
    "requiredEvidence",
    "missingInputs",
    "unknownPropagation",
    "boundary"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "phase": { "type": "string", "const": "phase-24" },
    "reportId": { "type": "string", "const": "execution-readiness-decision" },
    "generatedBy": { "type": "string", "const": "services/execution-decision/generate-execution-decision.ps1" },
    "generatedAt": { "type": "string", "minLength": 20 },
    "decisionQuestion": { "type": "string", "minLength": 20 },
    "decision": { "$ref": "#/$defs/decisionState" },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "monitoring", "evidence", "history", "observability", "simulation", "review"],
      "properties": {
        "authority": { "type": "string", "const": "runtime/authority/authority-read-model.report.json" },
        "monitoring": { "type": "string", "const": "runtime/authority/authority-projection-monitoring.report.json" },
        "evidence": { "type": "string", "const": "runtime/authority/authority-monitoring-evidence.report.json" },
        "history": { "type": "string", "const": "runtime/authority/authority-evidence-history.report.json" },
        "observability": { "type": "string", "const": "runtime/authority/authority-observability.report.json" },
        "simulation": { "type": "string", "const": "runtime/simulation/execution-simulation.report.json" },
        "review": { "type": "string", "const": "runtime/review/simulation-review.report.json" }
      }
    },
    "consumedReports": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/reportInput" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knownInputCount", "unknownInputCount", "staleInputCount", "reasonCount", "blockingConditionCount", "missingInputCount", "requiredEvidenceCount", "sourceSimulationStatus", "sourceReviewStatus"],
      "properties": {
        "knownInputCount": { "type": "integer", "minimum": 0 },
        "unknownInputCount": { "type": "integer", "minimum": 0 },
        "staleInputCount": { "type": "integer", "minimum": 0 },
        "reasonCount": { "type": "integer", "minimum": 0 },
        "blockingConditionCount": { "type": "integer", "minimum": 0 },
        "missingInputCount": { "type": "integer", "minimum": 0 },
        "requiredEvidenceCount": { "type": "integer", "minimum": 0 },
        "sourceSimulationStatus": { "type": "string", "enum": ["pass", "warning", "unknown"] },
        "sourceReviewStatus": { "type": "string", "enum": ["pass", "warning", "unknown"] }
      }
    },
    "reasons": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" } },
    "blockingConditions": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" } },
    "requiredEvidence": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" } },
    "missingInputs": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" } },
    "unknownPropagation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": { "$ref": "#/$defs/decisionState" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" } }
      }
    },
    "boundary": { "$ref": "#/$defs/boundary" }
  },
  "$defs": {
    "decisionState": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"] },
    "reportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "exists", "validJson", "lastModified", "isStale", "isComplete", "verdict", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "role": { "type": "string", "minLength": 3 },
        "exists": { "type": "boolean" },
        "validJson": { "type": "boolean" },
        "lastModified": { "type": ["string", "null"] },
        "isStale": { "type": "boolean" },
        "isComplete": { "type": "boolean" },
        "verdict": { "type": "string", "enum": ["known", "unknown"] },
        "reason": { "type": "string", "minLength": 3 }
      }
    },
    "decisionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "summary", "source", "authoritative"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "state": { "$ref": "#/$defs/decisionState" },
        "summary": { "type": "string", "minLength": 3 },
        "source": { "type": "string", "minLength": 3 },
        "authoritative": { "type": "boolean", "const": false }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionOnly",
        "readOnly",
        "derivedOnly",
        "reportWritingOnly",
        "ownsDecisionReports",
        "ownsAuthorityTruth",
        "ownsEvidenceTruth",
        "ownsMonitoringTruth",
        "ownsHistoryTruth",
        "ownsObservabilityTruth",
        "ownsSimulationTruth",
        "ownsReviewTruth",
        "ownsDashboardTruth",
        "ownsRuntimeTruth",
        "createsApprovals",
        "approvalWorkflowAllowed",
        "approvalMutationAllowed",
        "executionAllowed",
        "providerInvocationAllowed",
        "deploymentAllowed",
        "workflowExecutionAllowed",
        "commandExecutionAllowed",
        "queueAllowed",
        "workerAllowed",
        "schedulerAllowed",
        "repairAllowed",
        "autoRemediationAllowed",
        "credentialAccessAllowed",
        "secretAccessAllowed",
        "runtimeMutationAllowed",
        "dashboardMutationAllowed",
        "localStorageAuthorityAllowed",
        "sessionStorageAuthorityAllowed",
        "backgroundExecutionAllowed"
      ],
      "properties": {
        "decisionOnly": { "type": "boolean", "const": true },
        "readOnly": { "type": "boolean", "const": true },
        "derivedOnly": { "type": "boolean", "const": true },
        "reportWritingOnly": { "type": "boolean", "const": true },
        "ownsDecisionReports": { "type": "boolean", "const": true },
        "ownsAuthorityTruth": { "type": "boolean", "const": false },
        "ownsEvidenceTruth": { "type": "boolean", "const": false },
        "ownsMonitoringTruth": { "type": "boolean", "const": false },
        "ownsHistoryTruth": { "type": "boolean", "const": false },
        "ownsObservabilityTruth": { "type": "boolean", "const": false },
        "ownsSimulationTruth": { "type": "boolean", "const": false },
        "ownsReviewTruth": { "type": "boolean", "const": false },
        "ownsDashboardTruth": { "type": "boolean", "const": false },
        "ownsRuntimeTruth": { "type": "boolean", "const": false },
        "createsApprovals": { "type": "boolean", "const": false },
        "approvalWorkflowAllowed": { "type": "boolean", "const": false },
        "approvalMutationAllowed": { "type": "boolean", "const": false },
        "executionAllowed": { "type": "boolean", "const": false },
        "providerInvocationAllowed": { "type": "boolean", "const": false },
        "deploymentAllowed": { "type": "boolean", "const": false },
        "workflowExecutionAllowed": { "type": "boolean", "const": false },
        "commandExecutionAllowed": { "type": "boolean", "const": false },
        "queueAllowed": { "type": "boolean", "const": false },
        "workerAllowed": { "type": "boolean", "const": false },
        "schedulerAllowed": { "type": "boolean", "const": false },
        "repairAllowed": { "type": "boolean", "const": false },
        "autoRemediationAllowed": { "type": "boolean", "const": false },
        "credentialAccessAllowed": { "type": "boolean", "const": false },
        "secretAccessAllowed": { "type": "boolean", "const": false },
        "runtimeMutationAllowed": { "type": "boolean", "const": false },
        "dashboardMutationAllowed": { "type": "boolean", "const": false },
        "localStorageAuthorityAllowed": { "type": "boolean", "const": false },
        "sessionStorageAuthorityAllowed": { "type": "boolean", "const": false },
        "backgroundExecutionAllowed": { "type": "boolean", "const": false }
      }
    }
  }
}

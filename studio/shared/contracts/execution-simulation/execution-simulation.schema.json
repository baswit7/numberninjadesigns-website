{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/execution-simulation/execution-simulation.schema.json",
  "title": "Phase 22 Execution Governance Simulation Report",
  "description": "Non-executing governance simulation report for hypothetical workflow, command, provider, deployment or execution-plan requests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "reportId",
    "generatedBy",
    "generatedAt",
    "simulationQuestion",
    "sourceOfTruth",
    "consumedReports",
    "status",
    "summary",
    "readinessSimulation",
    "governanceImpact",
    "riskSimulation",
    "readinessScoring",
    "explainability",
    "unknowns",
    "boundary"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "phase": { "type": "string", "const": "phase-22" },
    "reportId": { "type": "string", "const": "execution-governance-simulation" },
    "generatedBy": { "type": "string", "const": "services/execution-simulation/generate-execution-simulation.ps1" },
    "generatedAt": { "type": "string", "minLength": 20 },
    "simulationQuestion": { "type": "string", "minLength": 20 },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governance", "authority", "observability", "readiness"],
      "properties": {
        "governance": { "type": "string", "const": "shared/contracts/execution" },
        "authority": { "type": "string", "const": "shared/contracts/authority + runtime/authority/authority-read-model.report.json" },
        "observability": { "type": "string", "const": "runtime/authority/authority-observability.report.json" },
        "readiness": { "type": "string", "const": "runtime/readiness/execution-plan.sample.json + runtime/readiness/readiness-report.sample.json" }
      }
    },
    "consumedReports": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/reportInput" } },
    "status": { "type": "string", "enum": ["pass", "warning", "unknown"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knownInputCount", "unknownInputCount", "staleInputCount", "warningCount", "unknownCount", "simulationReadinessScore", "governanceCompletenessScore", "approvalReadinessScore"],
      "properties": {
        "knownInputCount": { "type": "integer", "minimum": 0 },
        "unknownInputCount": { "type": "integer", "minimum": 0 },
        "staleInputCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "unknownCount": { "type": "integer", "minimum": 0 },
        "simulationReadinessScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "governanceCompletenessScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "approvalReadinessScore": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "readinessSimulation": { "$ref": "#/$defs/simulationGroup" },
    "governanceImpact": { "$ref": "#/$defs/simulationGroup" },
    "riskSimulation": { "$ref": "#/$defs/simulationGroup" },
    "readinessScoring": { "$ref": "#/$defs/simulationGroup" },
    "explainability": { "$ref": "#/$defs/simulationGroup" },
    "unknowns": { "$ref": "#/$defs/simulationGroup" },
    "boundary": { "$ref": "#/$defs/boundary" }
  },
  "$defs": {
    "reportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "exists", "validJson", "lastModified", "isStale", "isComplete", "verdict", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "role": { "type": "string", "minLength": 3 },
        "exists": { "type": "boolean" },
        "validJson": { "type": "boolean" },
        "lastModified": { "type": ["string", "null"] },
        "isStale": { "type": "boolean" },
        "isComplete": { "type": "boolean" },
        "verdict": { "type": "string", "enum": ["known", "unknown"] },
        "reason": { "type": "string", "minLength": 3 }
      }
    },
    "simulationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warning", "unknown"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/simulationItem" } }
      }
    },
    "simulationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "source", "safe"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "status": { "type": "string", "enum": ["pass", "warning", "unknown"] },
        "summary": { "type": "string", "minLength": 3 },
        "source": { "type": "string", "minLength": 3 },
        "safe": { "type": "boolean" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulationOnly",
        "hypotheticalOnly",
        "readOnly",
        "derivedOnly",
        "reportWritingOnly",
        "ownsSimulationReports",
        "ownsAuthorityTruth",
        "ownsGovernanceTruth",
        "ownsEvidenceTruth",
        "ownsMonitoringTruth",
        "ownsHistoryTruth",
        "ownsObservabilityTruth",
        "executionAllowed",
        "providerInvocationAllowed",
        "deploymentAllowed",
        "workflowExecutionAllowed",
        "commandExecutionAllowed",
        "orchestrationAllowed",
        "automationAllowed",
        "repairAllowed",
        "synchronizationAllowed",
        "approvalMutationAllowed",
        "authorityMutationAllowed",
        "evidenceMutationAllowed",
        "contractMutationAllowed",
        "credentialAccessAllowed",
        "secretAccessAllowed",
        "runtimeMutationAllowed",
        "dashboardMutationAllowed",
        "queueAllowed",
        "workerAllowed",
        "schedulerAllowed",
        "backgroundJobAllowed",
        "selfHealingAllowed",
        "retryAllowed",
        "providerAdapterAllowed"
      ],
      "properties": {
        "simulationOnly": { "type": "boolean", "const": true },
        "hypotheticalOnly": { "type": "boolean", "const": true },
        "readOnly": { "type": "boolean", "const": true },
        "derivedOnly": { "type": "boolean", "const": true },
        "reportWritingOnly": { "type": "boolean", "const": true },
        "ownsSimulationReports": { "type": "boolean", "const": true },
        "ownsAuthorityTruth": { "type": "boolean", "const": false },
        "ownsGovernanceTruth": { "type": "boolean", "const": false },
        "ownsEvidenceTruth": { "type": "boolean", "const": false },
        "ownsMonitoringTruth": { "type": "boolean", "const": false },
        "ownsHistoryTruth": { "type": "boolean", "const": false },
        "ownsObservabilityTruth": { "type": "boolean", "const": false },
        "executionAllowed": { "type": "boolean", "const": false },
        "providerInvocationAllowed": { "type": "boolean", "const": false },
        "deploymentAllowed": { "type": "boolean", "const": false },
        "workflowExecutionAllowed": { "type": "boolean", "const": false },
        "commandExecutionAllowed": { "type": "boolean", "const": false },
        "orchestrationAllowed": { "type": "boolean", "const": false },
        "automationAllowed": { "type": "boolean", "const": false },
        "repairAllowed": { "type": "boolean", "const": false },
        "synchronizationAllowed": { "type": "boolean", "const": false },
        "approvalMutationAllowed": { "type": "boolean", "const": false },
        "authorityMutationAllowed": { "type": "boolean", "const": false },
        "evidenceMutationAllowed": { "type": "boolean", "const": false },
        "contractMutationAllowed": { "type": "boolean", "const": false },
        "credentialAccessAllowed": { "type": "boolean", "const": false },
        "secretAccessAllowed": { "type": "boolean", "const": false },
        "runtimeMutationAllowed": { "type": "boolean", "const": false },
        "dashboardMutationAllowed": { "type": "boolean", "const": false },
        "queueAllowed": { "type": "boolean", "const": false },
        "workerAllowed": { "type": "boolean", "const": false },
        "schedulerAllowed": { "type": "boolean", "const": false },
        "backgroundJobAllowed": { "type": "boolean", "const": false },
        "selfHealingAllowed": { "type": "boolean", "const": false },
        "retryAllowed": { "type": "boolean", "const": false },
        "providerAdapterAllowed": { "type": "boolean", "const": false }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/coordination/coordination-health.schema.json",
  "title": "Phase 8 Coordination Health",
  "description": "Validates the read-only Phase 8 coordination health report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "source",
    "status",
    "executionAllowed",
    "checks",
    "warnings",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "const": "phase-8-coordination"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "blocked"
      ]
    },
    "executionAllowed": {
      "type": "boolean",
      "const": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

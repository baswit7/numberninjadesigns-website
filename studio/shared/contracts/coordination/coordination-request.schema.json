{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/coordination/coordination-request.schema.json",
  "title": "Phase 8 Coordination Request",
  "description": "Validates approved planning metadata before a coordination graph is generated. The request is metadata only and carries no executable instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "createdAt",
    "workflowId",
    "approvalState",
    "objective",
    "sourcePhase",
    "planningInputs",
    "forbiddenCapabilities",
    "executionAllowed",
    "nonExecutableMetadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*[a-z0-9]$",
      "minLength": 3,
      "maxLength": 120
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "workflowId": {
      "type": "string",
      "enum": [
        "feature-development",
        "bug-resolution",
        "documentation-update",
        "release-preparation",
        "architecture-review"
      ]
    },
    "approvalState": {
      "type": "string",
      "const": "approved_for_coordination"
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800
    },
    "sourcePhase": {
      "type": "string",
      "enum": [
        "phase-7-command-preparation",
        "governance-review",
        "architecture-review"
      ]
    },
    "planningInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "command_classification",
              "action_plan",
              "release_checklist",
              "architecture_note",
              "governance_evidence"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        }
      }
    },
    "forbiddenCapabilities": {
      "$ref": "#/$defs/forbiddenCapabilities"
    },
    "executionAllowed": {
      "type": "boolean",
      "const": false
    },
    "nonExecutableMetadata": {
      "$ref": "#/$defs/nonExecutableMetadata"
    }
  },
  "$defs": {
    "forbiddenCapabilities": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string",
        "enum": [
          "provider_execution",
          "api_calls",
          "deployments",
          "runtime_mutation",
          "shell_execution",
          "command_execution",
          "code_generation_execution",
          "agent_execution",
          "task_runners",
          "schedulers",
          "background_services",
          "business_features",
          "executable_hooks",
          "provider_credentials"
        ]
      },
      "uniqueItems": true
    },
    "nonExecutableMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "owner",
        "safetyClass"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "const": "phase-8"
        },
        "owner": {
          "type": "string",
          "const": "studio-os"
        },
        "safetyClass": {
          "type": "string",
          "const": "coordination-only"
        }
      }
    }
  }
}

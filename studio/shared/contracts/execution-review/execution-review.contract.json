{
  "schemaVersion": "1.0.0",
  "contractId": "studio-os-v2-manual-execution-review-gate",
  "capability": "manual-execution-review-gate",
  "mode": "non-executing-manual-review-records-only",
  "sourceOfTruth": "shared/contracts/execution-review/execution-review.contract.json",
  "schema": "shared/contracts/execution-review/execution-review.schema.json",
  "preflightDecisionInput": "runtime/execution-preflight/execution-preflight.decisions.json",
  "preflightReportInput": "runtime/execution-preflight/execution-preflight.report.json",
  "generatedRecords": "runtime/execution-review/execution-review.records.json",
  "generatedAudit": "runtime/execution-review/execution-review.audit.json",
  "generatedReport": "runtime/execution-review/execution-review.report.json",
  "allowedReviewStates": [
    "UNKNOWN",
    "BLOCKED",
    "PENDING_REVIEW",
    "APPROVED_FOR_DISPATCH",
    "REJECTED",
    "EXPIRED"
  ],
  "requiredManualEvidence": [
    "human reviewer identity",
    "review timestamp",
    "scope confirmation",
    "risk acceptance",
    "dispatch boundary acknowledgement"
  ],
  "reviewRules": {
    "unknownNeverApprovesForDispatchAutomatically": true,
    "onlyReadyForManualReviewMayBecomePendingReview": true,
    "blockedPreflightRemainsBlocked": true,
    "failedPreflightBecomesRejectedOrBlocked": true,
    "approvedForDispatchRequiresManualEvidence": true,
    "approvedForDispatchDoesNotExecute": true,
    "reviewGateDoesNotMutateInputs": true,
    "reviewGateDoesNotDispatch": true
  },
  "ownership": {
    "ownsManualReviewRecords": true,
    "ownsManualReviewAuditTrail": true,
    "ownsManualReviewEvidence": true,
    "ownsPreflightDecisions": false,
    "ownsExecutionRequestPackages": false,
    "ownsApprovalRecords": false,
    "ownsExecutionTruth": false,
    "ownsProviderTruth": false,
    "ownsDeploymentTruth": false,
    "ownsGithubTruth": false
  },
  "boundaries": {
    "manualReviewOnly": true,
    "performsExecution": false,
    "executionDispatch": false,
    "automaticExecution": false,
    "liveGitHubActionExecution": false,
    "providerExecution": false,
    "deploymentExecution": false,
    "mergeExecution": false,
    "approvalMutation": false,
    "requestPackageMutation": false,
    "preflightMutation": false,
    "autoApproval": false,
    "autoReviewApproval": false,
    "autoMerge": false,
    "backgroundWorkers": false,
    "schedulers": false,
    "queues": false,
    "autonomousRunner": false,
    "softwareFactory": false,
    "secretAccess": false,
    "credentialAccess": false,
    "protectedBranchWrites": false,
    "repositorySettingsMutation": false,
    "collaboratorMutation": false,
    "deploymentMutation": false,
    "mutatesFilesOutsideRuntimeReports": false
  }
}

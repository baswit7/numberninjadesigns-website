{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-os://shared/contracts/readiness/execution-plan.schema.json",
  "title": "Phase 10 Execution Plan",
  "description": "Models a future execution plan as readiness-only metadata. It never grants permission or runs work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "createdAt", "objective", "steps", "forbiddenCapabilities", "readinessDecisionId", "executionAllowed", "readinessOnly", "nonExecutableMetadata"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "executionAllowed": { "type": "boolean", "const": false },
    "readinessOnly": { "type": "boolean", "const": true },
    "nonExecutableMetadata": { "$ref": "#/$defs/nonExecutableMetadata" },
    "planId": { "$ref": "#/$defs/identifier" },
    "createdAt": { "type": "string", "format": "date-time" },
    "objective": { "$ref": "#/$defs/nonEmptyString" },
    "sourceGovernanceRequestId": { "type": "string", "minLength": 3, "maxLength": 140 },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["stepId", "title", "readinessStatus", "executionAllowed"], "properties": { "stepId": { "$ref": "#/$defs/identifier" }, "title": { "$ref": "#/$defs/nonEmptyString" }, "readinessStatus": { "$ref": "#/$defs/readinessStatus" }, "executionAllowed": { "type": "boolean", "const": false } } } },
    "forbiddenCapabilities": { "$ref": "#/$defs/forbiddenCapabilities" },
    "readinessDecisionId": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "forbiddenCapabilities": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["workflow_execution", "agent_execution", "provider_execution", "model_api_calls", "github_api_calls", "deployments", "runtime_mutation", "secret_access", "credential_access", "queues", "schedulers", "workers", "executors", "business_features"] }
    },
    "nonExecutableMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "owner", "safetyClass"],
      "properties": {
        "phase": { "type": "string", "const": "phase-10" },
        "owner": { "type": "string", "const": "studio-os" },
        "safetyClass": { "type": "string", "enum": ["execution-readiness-only", "readiness-sample", "readiness-validation"] }
      }
    },
    "identifier": { "type": "string", "minLength": 3, "maxLength": 140, "pattern": "^[a-z0-9][a-z0-9._:-]*[a-z0-9]$" },
    "nonEmptyString": { "type": "string", "minLength": 2, "maxLength": 800 },
    "readinessStatus": { "type": "string", "enum": ["ready", "partial", "blocked", "missing", "not-applicable"] },
    "severity": { "type": "string", "enum": ["info", "warning", "blocking"] }
  }
}

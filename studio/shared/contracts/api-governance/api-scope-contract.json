{
  "schemaVersion": "1.0.0",
  "contractId": "studio-os-api-scope-contract",
  "sourceRegistry": "shared/contracts/api-governance/api-registry.json",
  "runtimeReport": "runtime/api-governance/api-scope-validation.report.json",
  "requiredFields": ["apiId", "requiredScopes", "grantedScopes", "missingScopes", "status"],

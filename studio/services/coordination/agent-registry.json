{
  "schemaVersion": "1.0.0",
  "registryId": "studio-os.phase-8.agent-registry",
  "executionAllowed": false,
  "agents": [
    {
      "id": "chatgpt-architect",
      "displayName": "ChatGPT Architect",
      "role": "Owns architecture reasoning, scope framing, compatibility review and safety-boundary interpretation for coordination plans.",
      "allowedInputs": [
        "approved command metadata",
        "architecture documents",
        "governance reports",
        "contract summaries"
      ],
      "allowedOutputs": [
        "architecture coordination notes",
        "compatibility questions",
        "non-executing design recommendations"
      ],
      "forbiddenCapabilities": [
        "provider_execution",
        "api_calls",
        "deployments",
        "runtime_mutation",
        "shell_execution",
        "command_execution",
        "code_generation_execution",
        "agent_execution",
        "task_runners",
        "schedulers",
        "background_services",
        "business_features",
        "executable_hooks",
        "provider_credentials"
      ],
      "safetyBoundary": "May coordinate architecture reasoning only. It cannot execute tools, call providers, deploy, mutate runtime state, schedule work or act as an autonomous agent.",
      "executionAllowed": false
    },
    {
      "id": "codex-builder",
      "displayName": "Codex Builder",

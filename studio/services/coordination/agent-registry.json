        "command_execution",
        "code_generation_execution",
        "agent_execution",
        "task_runners",
        "schedulers",
        "background_services",
        "business_features",
        "executable_hooks",
        "provider_credentials"
      ],
      "safetyBoundary": "May appear as a future handoff target in a graph only. Phase 8 never invokes Codex, generates source code through Codex or runs implementation steps.",
      "executionAllowed": false
    },

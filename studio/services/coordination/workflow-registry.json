{
  "schemaVersion": "1.0.0",
  "registryId": "studio-os.phase-8.workflow-registry",
  "executionAllowed": false,
  "workflows": [
    {
      "id": "feature-development",
      "displayName": "Feature Development",
      "purpose": "Coordinate approved feature work from architecture framing through documentation, review, future implementation handoff and quality planning without executing work.",
      "orderedStages": [
        {
          "id": "architecture",
          "displayName": "Architecture",
          "agentId": "chatgpt-architect",
          "purpose": "Frame the architecture and compatibility boundary for the approved feature request.",
          "inputRefs": [
            "coordination-request",
            "architecture-docs"
          ],
          "outputRefs": [
            "architecture-coordination-notes"
          ],
          "executionAllowed": false
        },
        {
          "id": "documentation",
          "displayName": "Documentation",
          "agentId": "documentation-agent",
          "purpose": "Coordinate required documentation updates and traceability expectations.",
          "inputRefs": [
            "architecture-coordination-notes"
          ],
          "outputRefs": [
            "documentation-plan"
          ],
          "executionAllowed": false
        },
        {
          "id": "review",
          "displayName": "Review",
          "agentId": "review-agent",
          "purpose": "Define review checkpoints and approval dependencies before future implementation.",
          "inputRefs": [
            "architecture-coordination-notes",
            "documentation-plan"
          ],
          "outputRefs": [
            "review-checkpoints"
          ],
          "executionAllowed": false
        },
        {
          "id": "future-build-handoff",
          "displayName": "Future Build Handoff",
          "agentId": "codex-builder",
          "purpose": "Prepare non-executing implementation readiness metadata for a future approved branch.",
          "inputRefs": [
            "review-checkpoints"
          ],
          "outputRefs": [
            "implementation-readiness-notes"
          ],
          "executionAllowed": false
        },
        {
          "id": "quality-planning",
          "displayName": "Quality Planning",
          "agentId": "qa-agent",
          "purpose": "Coordinate validation expectations and acceptance criteria for future work.",
          "inputRefs": [
            "implementation-readiness-notes"
          ],
          "outputRefs": [
            "qa-readiness-notes"
          ],
          "executionAllowed": false
        }
      ],
      "requiredAgents": [
        "chatgpt-architect",
        "documentation-agent",
        "review-agent",
        "codex-builder",
        "qa-agent"
      ],
      "dependencies": [
        {
          "fromStage": "architecture",
          "toStage": "documentation",
          "type": "provides_context"
        },
        {
          "fromStage": "documentation",
          "toStage": "review",
          "type": "requires_evidence"
        },
        {
          "fromStage": "review",
          "toStage": "future-build-handoff",
          "type": "blocks_until_reviewed"
        },
        {
          "fromStage": "future-build-handoff",
          "toStage": "quality-planning",
          "type": "provides_context"
        }
      ],
      "gates": [
        {
          "id": "human-review",
          "displayName": "Human Review Required",
          "type": "human_review",
          "blocksExecution": true,
          "executionAllowed": false
        },
        {
          "id": "contract-check",
          "displayName": "Contract Boundary Check",
          "type": "contract_check",
          "blocksExecution": true,
          "executionAllowed": false
        }
      ],
      "forbiddenCapabilities": [
        "provider_execution",
        "api_calls",
        "deployments",
        "runtime_mutation",
        "shell_execution",
        "command_execution",
        "code_generation_execution",
        "agent_execution",
        "task_runners",
        "schedulers",
        "background_services",
        "business_features",
        "executable_hooks",
        "provider_credentials"
      ],
      "executionAllowed": false

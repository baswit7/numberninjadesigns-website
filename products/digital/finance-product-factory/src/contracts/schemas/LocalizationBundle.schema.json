{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-product-factory:contracts:LocalizationBundle:1.0.0",
  "title": "LocalizationBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "version", "status", "messages", "formats"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" },
    "version": { "type": "string", "format": "semver" },
    "status": { "enum": ["draft", "beta", "active", "deprecated", "retired"] },
    "fallbackLocale": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" }
      ]
    },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "decimalSeparator", "thousandsSeparator", "paperSize"],
      "properties": {
        "date": { "type": "string", "minLength": 4, "maxLength": 24 },
        "decimalSeparator": { "enum": [".", ","] },
        "thousandsSeparator": { "enum": [".", ",", " "] },
        "paperSize": { "enum": ["A4", "Letter", "Legal"] }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-product-factory:contracts:ProductConfiguration:1.0.0",
  "title": "ProductConfiguration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "productVersion",
    "locale",
    "market",
    "currency",
    "year",
    "themeId",
    "title",
    "filename",
    "inputCapacity",
    "sampleDataEnabled",
    "categoryOverrides",
    "featureFlags",
    "branding",
    "outputOptions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "productVersion": { "type": "string", "format": "semver" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" },
    "market": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2200 },
    "themeId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "filename": {
      "type": "string",
      "minLength": 6,
      "maxLength": 160,
      "pattern": "^(?!.*[\\\\/:*?\"<>|])(?!\\.)(?!.*\\.$).+\\.(?:xlsx|docx)$"
    },
    "categoryOverrides": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "brandName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 160 },
        "logoAssetId": { "type": ["string", "null"], "maxLength": 160 },
        "colors": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    },
    "sampleDataEnabled": { "type": "boolean" },
    "inputCapacity": { "type": "integer", "minimum": 10, "maximum": 10000 },
    "outputOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "customerDocs", "listing", "imageManifests"],
      "properties": {
        "workbook": { "type": "boolean" },
        "documents": { "type": "boolean" },
        "package": { "type": "boolean" },
        "customerDocs": { "type": "boolean" },
        "listing": { "type": "boolean" },
        "imageManifests": { "type": "boolean" }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-product-factory:contracts:ImageProductionManifest:1.0.0",
  "title": "ImageProductionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "productVersion", "locale", "theme", "generatedAt", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "productVersion": { "type": "string", "format": "semver" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" },
    "theme": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "purpose", "width", "height", "format", "filename", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 100 },
          "purpose": { "enum": ["thumbnail", "feature", "workflow", "contents", "compatibility", "instructions", "comparison", "trust", "bundle", "detail", "other"] },
          "width": { "type": "integer", "minimum": 300, "maximum": 10000 },
          "height": { "type": "integer", "minimum": 300, "maximum": 10000 },
          "format": { "enum": ["png", "webp", "jpg"] },
          "filename": { "type": "string", "pattern": "^(?!.*[\\\\/]).+\\.(?:png|webp|jpg)$" },
          "packagePath": { "type": "string", "pattern": "^listing/images/[0-9]{2}-[a-z0-9-]+\\.png$" },
          "status": { "enum": ["required", "planned", "generated", "validated", "rejected"] },
          "sourceAssetId": { "type": ["string", "null"] },
          "altTextKey": { "type": "string" },
          "altText": { "type": "string", "minLength": 1, "maxLength": 250 },
          "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "mediaType": { "const": "image/png" },
          "bytes": { "type": "integer", "minimum": 1 },
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" },
          "theme": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "tier": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "appearance": { "enum": ["light", "dark"] },
          "renderSource": { "type": "string", "minLength": 1, "maxLength": 120 },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

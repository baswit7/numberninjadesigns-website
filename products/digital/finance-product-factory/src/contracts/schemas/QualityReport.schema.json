{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-product-factory:contracts:QualityReport:1.0.0",
  "title": "QualityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "productVersion", "status", "score", "threshold", "components", "recommendations", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "productVersion": { "type": "string", "format": "semver" },
    "status": { "enum": ["PASS", "REVIEW", "FAIL"] },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "threshold": { "type": "number", "minimum": 0, "maximum": 100 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "weight", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "generatedAt": { "type": "string", "format": "date-time" },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

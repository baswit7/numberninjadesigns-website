{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-product-factory:contracts:GeneratedProductManifest:1.0.0",
  "title": "GeneratedProductManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "factoryVersion",
    "productId",
    "productVersion",
    "configurationHash",
    "configuration",
    "generatedAt",
    "files",
    "checksums",
    "validationStatus",
    "qualityScore",
    "compatibilityStatus",
    "warnings",
    "assumptions",
    "sourceDefinitions",
    "releaseStatus",
    "validationReport",
    "qualityReport",
    "compatibilityReport"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "factoryVersion": { "type": "string", "format": "semver" },
    "productId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "productVersion": { "type": "string", "format": "semver" },
    "configurationHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "configuration": { "$ref": "urn:finance-product-factory:contracts:ProductConfiguration:1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "mediaType", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "role": { "enum": ["workbook", "document", "readme", "license", "manifest", "listing", "image", "source", "report", "other"] },
          "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
    },
    "validationStatus": { "enum": ["PASS", "FAIL"] },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "compatibilityStatus": { "enum": ["PASS", "PARTIAL", "FAIL", "NOT_TESTED"] },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "uniqueItems": true
    },
    "sourceDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "version", "sha256"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "format": "semver" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "releaseStatus": { "enum": ["DRAFT", "READY_FOR_REVIEW", "BLOCKED", "APPROVED", "REJECTED", "RELEASED", "REVOKED"] },
    "validationReport": { "$ref": "urn:finance-product-factory:contracts:ValidationReport:1.0.0" },
    "qualityReport": { "$ref": "urn:finance-product-factory:contracts:QualityReport:1.0.0" },
    "compatibilityReport": { "$ref": "urn:finance-product-factory:contracts:CompatibilityReport:1.0.0" },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

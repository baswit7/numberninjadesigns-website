{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-product-factory:contracts:ReleaseManifest:1.0.0",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "status",
    "productId",
    "productVersion",
    "createdAt",
    "generatedProduct",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "releaseId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "status": { "enum": ["DRAFT", "READY_FOR_REVIEW", "APPROVED", "REJECTED", "RELEASED", "REVOKED"] },
    "productId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "productVersion": { "type": "string", "format": "semver" },
    "createdAt": { "type": "string", "format": "date-time" },
    "generatedProduct": { "$ref": "urn:finance-product-factory:contracts:GeneratedProductManifest:1.0.0" },
    "images": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "urn:finance-product-factory:contracts:ImageProductionManifest:1.0.0" }
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "decision", "decidedAt"],
        "properties": {
          "role": { "enum": ["creator", "quality", "commercial", "release"] },
          "decision": { "enum": ["APPROVED", "REJECTED"] },
          "decidedAt": { "type": "string", "format": "date-time" },
          "actorId": { "type": ["string", "null"], "maxLength": 120 },
          "notes": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "releasedAt": { "type": ["string", "null"], "format": "date-time" },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

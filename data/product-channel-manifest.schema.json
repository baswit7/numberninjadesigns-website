{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.numberninjadesigns.com/data/product-channel-manifest.schema.json",
  "title": "NumberNinjaDesigns product-channel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "canonicalHost",
    "products"
  ],
  "properties": {
    "$schema": {
      "const": "https://www.numberninjadesigns.com/data/product-channel-manifest.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "canonicalHost": {
      "const": "https://www.numberninjadesigns.com"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "nullableIdentifier": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+$"
    },
    "nullableUri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalUrl",
        "title",
        "description",
        "indexable",
        "sitemapIncluded"
      ],
      "properties": {
        "canonicalUrl": {
          "type": "string",
          "pattern": "^https://www\\.numberninjadesigns\\.com/[a-z0-9-]+\\.html$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "indexable": {
          "type": "boolean"
        },
        "sitemapIncluded": {
          "type": "boolean"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ownerApproved",
        "indexingApproved",
        "providerPublicationAllowed",
        "contentHash"
      ],
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "OWNER_APPROVED_PREVIEW",
            "RELEASED"
          ]
        },
        "ownerApproved": {
          "type": "boolean"
        },
        "indexingApproved": {
          "type": "boolean"
        },
        "providerPublicationAllowed": {
          "type": "boolean"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "etsy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationEnabled",
        "listingId",
        "listingUrl"
      ],
      "properties": {
        "publicationEnabled": {
          "type": "boolean"
        },
        "listingId": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "listingUrl": {
          "$ref": "#/$defs/nullableUri"
        }
      }
    },
    "pinterest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationEnabled",
        "locale",
        "market",
        "boardId",
        "pinId",
        "pinUrl"
      ],
      "properties": {
        "publicationEnabled": {
          "type": "boolean"
        },
        "locale": {
          "enum": [
            "en-US",
            "de-DE"
          ]
        },
        "market": {
          "enum": [
            "US",
            "DE"
          ]
        },
        "boardId": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "pinId": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "pinUrl": {
          "$ref": "#/$defs/nullableUri"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "productVersion",
        "locale",
        "market",
        "site",
        "release",
        "etsy",
        "pinterest"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "productVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "locale": {
          "enum": [
            "en-US",
            "de-DE"
          ]
        },
        "market": {
          "enum": [
            "US",
            "DE"
          ]
        },
        "site": {
          "$ref": "#/$defs/site"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "etsy": {
          "$ref": "#/$defs/etsy"
        },
        "pinterest": {
          "$ref": "#/$defs/pinterest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "locale": {
                "const": "en-US"
              }
            },
            "required": [
              "locale"
            ]
          },
          "then": {
            "properties": {
              "market": {
                "const": "US"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "locale": {
                "const": "de-DE"
              }
            },
            "required": [
              "locale"
            ]
          },
          "then": {
            "properties": {
              "market": {
                "const": "DE"
              }
            }
          }
        }
      ]
    }
  }
}

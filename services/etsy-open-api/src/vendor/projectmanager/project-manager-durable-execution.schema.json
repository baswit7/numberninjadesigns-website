{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-os.local/contracts/v2/project-manager-durable-execution.schema.json",
  "title": "NumberNinja Projectmanager durable execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionId",
    "taskId",
    "ownerIntentHash",
    "planId",
    "planContentHash",
    "state",
    "createdAt",
    "updatedAt",
    "lastHeartbeatAt",
    "step",
    "currentComponent",
    "attempt",
    "idempotencyKey",
    "approvalState",
    "costState",
    "blockingReason",
    "resultId",
    "resultHash",
    "providerReadbackState",
    "retryEligible",
    "lastErrorClass",
    "nextEligibleRun",
    "leaseOwner",
    "fencingToken",
    "leaseExpiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "executionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$" },
    "taskId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,159}$" },
    "ownerIntentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$" },
    "planContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": {
      "enum": [
        "PLANNED",
        "QUEUED",
        "RUNNING",
        "AWAITING_APPROVAL",
        "BLOCKED_EXTERNAL",
        "BLOCKED_INTERNAL",
        "RETRY_ELIGIBLE",
        "COMPLETED",
        "FAILED_TERMINAL"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lastHeartbeatAt": { "type": ["string", "null"], "format": "date-time" },
    "step": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 120 },
    "currentComponent": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 160 },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 100 },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$" },
    "approvalState": { "enum": ["NOT_REQUIRED_READ_ONLY", "PENDING", "GRANTED", "DENIED"] },
    "costState": { "enum": ["ZERO_NEW_RECURRING_COMMITMENT", "UNKNOWN", "BLOCKED"] },
    "blockingReason": { "type": ["string", "null"], "maxLength": 2000 },
    "resultId": { "type": ["string", "null"], "maxLength": 160 },
    "resultHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "providerReadbackState": { "enum": ["PENDING", "NOT_CALLED", "FRESH", "REFRESHED", "FAILED"] },
    "retryEligible": { "type": "boolean" },
    "lastErrorClass": { "type": ["string", "null"], "maxLength": 160 },
    "nextEligibleRun": { "type": ["string", "null"], "format": "date-time" },
    "leaseOwner": { "type": ["string", "null"], "maxLength": 160 },
    "fencingToken": { "type": "integer", "minimum": 0 },
    "leaseExpiresAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
